# Dependency directories (both root, frontend, and backend)
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/

# Production build artifacts
dist/
frontend/dist/
dist-ssr/
build/
out/

# Environment and sensitive credential files
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Uploaded user files & media (keep folder structure with .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# System and logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS metadata files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and editor settings
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# Temporary and test artifacts
.temp/
.tmp/
coverage/
*.lcov
test_aggregation.js
